<link rel="stylesheet" href="/css/attacking.css">
<div class="attack-page">
<header class="attack-heading"><h1>Attacking Page</h1><span id="attackTimer">25 rounds maximum</span></header>
<p id="fightResult" role="status" hidden></p>
<section id="attackArena" class="attack-arena" aria-label="Fight">
 <% [true,false].forEach(isYou=>{ %><article class="fighter-panel"><header><strong id="<%= isYou?'yourName':'enemyName' %>"><%= isYou?user.username:'Choose a target' %></strong><span id="<%= isYou?'yourLife':'enemyLife' %>"><%= isYou?user.hp+' / '+user.max_hp:'—' %></span><meter id="<%= isYou?'yourHealth':'enemyHealth' %>" min="0" max="<%= isYou?user.max_hp:100 %>" value="<%= isYou?user.hp:100 %>"></meter></header><div class="fighter-stage"><img src="/img/combat-fighter.png" alt="Combatant body diagram"><% if(isYou) { %><div id="battleControls" class="battle-controls"><strong id="battleStatus">READY TO ATTACK</strong><p id="battleHint">25 Energy · 10% stamina</p><button id="startAttack" type="button" disabled>ATTACK</button><div id="victoryChoices" hidden><button data-ending="leave">LEAVE</button><button data-ending="mug">MUG</button><button data-ending="hospitalize">HOSPITALIZE</button><small>Leave for the most XP and respect.</small></div></div><% } %></div><footer id="<%= isYou?'yourOutcome':'enemyOutcome' %>"><%= isYou?'Select a weapon, then Attack or Use to play one turn.':'Opponent' %></footer></article><% }); %>
</section>
<section id="weaponTray" class="weapon-tray" aria-label="Weapon and action tray" hidden></section><div id="battleComplete" hidden><a id="backToProfile" href="/citizens">Back to Profile</a> · <a href="/city">Continue →</a></div>
<div class="attack-bottom"><section class="action-table"><header><b>Action</b><b>Time</b></header><div id="logLines" aria-live="polite"><p>Choose a citizen below to begin.</p></div></section><aside class="people-involved"><header>People involved<br><small>One-on-one attack · up to 25 rounds</small></header><p><strong><%= user.username %></strong></p><p id="participantHealth"><%= user.hp %> / <%= user.max_hp %> HP</p><meter id="participantMeter" min="0" max="<%= user.max_hp %>" value="<%= user.hp %>"></meter><p id="fightReadiness"></p><a href="/equipment">Manage equipment →</a></aside></div>
<section class="attack-targets"><h2>Choose your target</h2><label>Combat stance <select id="fightStance"><option value="balanced">Balanced</option><option value="aggressive">Aggressive</option><option value="defensive">Defensive</option></select></label><p>Same city only. A 10-minute cooldown applies per target. Need energy? Energy drinks and Xanax can raise energy above your normal maximum. <a href="/market">Item market →</a></p><div class="table-scroll"><table><thead><tr><th>Citizen</th><th>Level</th><th>Life</th><th>Action</th></tr></thead><tbody>
<% targets.forEach(t=>{const recovering=t.in_hospital&&t.hospital_until>now||t.in_jail&&t.jail_until>now;const ready=(cdMap[t.id]||0)+600; %><tr><td><a href="/profile/<%= encodeURIComponent(t.username) %>"><%= t.username %></a></td><td><%= t.level %></td><td><%= t.hp %> / <%= t.max_hp %></td><td><button data-target="<%= t.id %>" data-ready="<%= ready %>" data-recovering="<%= recovering %>"><%= recovering?'Recovering':'Attack' %></button></td></tr><% }); %>
</tbody></table></div></section>
<% if(history.length) { %><details class="attack-history"><summary>Recent battles</summary><% history.forEach(h=>{ %><p><%= h.opp_name %> · <%= h.result %> · <%= h.ending==='pending'?'Awaiting winner’s choice':h.ending %> · <%= timeAgo(h.created_at) %></p><% }); %></details><% } %>
</div>
<script type="application/json" id="battleState"><%- JSON.stringify({user:{energy:user.energy,stamina:user.stamina,hp:user.hp,max_hp:user.max_hp,in_jail:user.in_jail,in_hospital:user.in_hospital},energyCost,battle,targets:targets.map(t=>({id:t.id,username:t.username,hp:t.hp,max_hp:t.max_hp})),pending:pending?{defender_id:pending.defender_id,username:pending.username,max_hp:pending.max_hp,expiresAt:pending.expires_at,log:pending.log.split('\n')}:null}).replace(/</g,'\\u003c') %></script>
<script src="/js/battles.js" defer></script>
