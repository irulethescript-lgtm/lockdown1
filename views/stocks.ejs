<% const cash=n=>'$'+Number(n).toLocaleString(undefined,{maximumFractionDigits:2}); %>
<div class="page-heading"><div><span class="eyebrow">FINANCIAL DISTRICT / LOCKDOWN EXCHANGE</span><h1>Stock Exchange</h1><p>Build your portfolio. Unlock benefits. Collect dividends.</p></div><a class="text-link" href="/points">Points Building →</a></div>
<p id="economy-feedback" class="economy-status" role="status" hidden></p>
<% if(!data.account){ %><section class="economy-card"><h2>Your first investment</h2><p>A Stock Ticker unlocks trading. Purchase it for 50 points.</p><form data-economy action="/stocks/action"><input type="hidden" name="action" value="ticker"><button class="action-button">Buy Stock Ticker · 50 points</button></form></section><% }else{ %><div class="economy-metrics"><div><small>POSITIONS</small><strong><%= data.positions.length %></strong></div><div><small>REALIZED PROFIT / LOSS</small><strong><%= cash(data.account.profit) %></strong></div><div><small>SELLING FEES PAID</small><strong><%= cash(data.account.fees) %></strong></div></div><% } %>
<p class="economy-notice">Lockdown uses simulated prices, refreshed each minute. Selling costs 0.1%. Passive benefits mature after 7 days. Active dividends pause until claimed; extra blocks join the next cycle. Selling below your current block count restarts progress. Trading is unavailable in hospital, jail, during travel or while unconscious.</p>
<label class="economy-form">Find a company <input type="search" data-filter-list=".stock-row" placeholder="Name or symbol"></label>
<% data.stocks.forEach(s=>{const positions=data.positions.filter(p=>p.symbol===s.symbol);const shares=positions.reduce((n,p)=>n+p.shares,0);const b=data.benefits.find(b=>b.symbol===s.symbol);const ready=b.cycle_blocks&&data.today>=b.started_day+(s.days||7); %>
<details class="economy-card stock-row" data-search="<%= s.name+' '+s.symbol %>"><summary><strong><%= s.symbol %></strong> · <%= s.name %> · <%= cash(s.cents/100) %> <span style="color:<%= s.cents>=s.previous?'#49e6b0':'#ff899b' %>"><%= ((s.cents/s.previous-1)*100).toFixed(2) %>%</span> · Owned <%= shares.toLocaleString() %></summary>
<p><%= s.days?'Active dividend every '+s.days+' days':'Passive benefit after 7 days' %>: <strong><%= typeof s.reward==='number'?cash(s.reward):s.amount>1?s.amount+' '+s.reward:s.reward %></strong></p><p>First block: <%= s.shares.toLocaleString() %> shares · Blocks: <%= b.blocks %> · <%= !b.blocks?'No benefit block':ready?(s.days?'Dividend ready':'Benefit active'):Math.max(0,(s.days||7)-(data.today-b.started_day))+' days remaining' %></p>
<% if(data.account){ %><form data-economy class="economy-form" action="/stocks/action"><input type="hidden" name="symbol" value="<%= s.symbol %>"><input type="hidden" name="quote" value="<%= s.cents %>"><label>Shares<input name="shares" type="number" min="1" step="1" required></label><button class="action-button" name="action" value="buy">Buy</button><button class="action-button" name="action" value="sell">Sell · 0.1% fee</button></form>
<% if(shares){ %><p>Selling can interrupt benefits and dividend progress.</p><div class="economy-table-wrap"><table class="economy-table"><thead><tr><th>Bought</th><th>Shares</th><th>Cost</th><th>Profit / loss before fees</th><th>Sell position</th></tr></thead><tbody><% positions.forEach(p=>{ %><tr><td><%= new Date(p.bought_at*1000).toLocaleDateString('en-GB',{timeZone:'UTC'}) %></td><td><%= p.shares.toLocaleString() %></td><td><%= cash(p.cost) %></td><td><%= cash(p.shares*s.cents/100-p.cost) %></td><td><form data-economy action="/stocks/action"><input type="hidden" name="action" value="sell"><input type="hidden" name="symbol" value="<%= s.symbol %>"><input type="hidden" name="quote" value="<%= s.cents %>"><input type="hidden" name="shares" value="<%= p.shares %>"><input type="hidden" name="position_id" value="<%= p.id %>"><button class="action-button">Sell</button></form></td></tr><% }); %></tbody></table></div><% } %>
<form data-economy class="economy-form" action="/stocks/action"><input type="hidden" name="symbol" value="<%= s.symbol %>"><% if(positions.length>1){ %><button class="action-button" name="action" value="merge">Merge positions</button><% } %><% if(s.days&&ready){ %><button class="action-button" name="action" value="claim">Collect <%= b.cycle_blocks %> dividend<%= b.cycle_blocks===1?'':'s' %></button><% } %></form><% } %></details><% }); %>
<% if(data.rewards.length){ %><section class="economy-card"><h2>Property dividend deeds</h2><% data.rewards.forEach(r=>{ %><form data-economy class="economy-form" action="/stocks/action"><input type="hidden" name="action" value="redeem-property"><input type="hidden" name="symbol" value="HRG"><input type="hidden" name="reward_id" value="<%= r.id %>"><span><%= r.home_key %></span><button class="action-button">Redeem deed</button></form><% }); %></section><% } %>
<script src="/js/economy.js" defer></script>
