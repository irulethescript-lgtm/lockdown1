<% const cash=n=>'$'+Math.floor(n).toLocaleString();const c=data.company;const director=c?.director_id===user.id;const type=c?data.types.find(t=>t.key===c.type):null; %>
<div class="page-heading"><div><span class="eyebrow">INDUSTRIAL DISTRICT / PLAYER BUSINESSES</span><h1>Companies</h1><p>Start a business. Build your team. Grow your city.</p></div><a class="text-link" href="/jobs">City jobs →</a></div><p id="economy-feedback" class="economy-status" role="status" hidden></p>
<nav class="economy-tabs"><a href="#your-company">Your company</a><a href="#directory">Hiring directory</a><a href="#start-company">Start a company</a></nav>
<div class="economy-metrics"><div><small>MANUAL LABOR</small><strong><%= data.profile.manual.toLocaleString() %></strong></div><div><small>INTELLIGENCE</small><strong><%= data.profile.intelligence.toLocaleString() %></strong></div><div><small>ENDURANCE</small><strong><%= data.profile.endurance.toLocaleString() %></strong></div></div>
<p class="economy-notice">Work from level 3; direct from level 10. Company closing is 18:00 UTC. Keep a week of payroll and advertising in your vault. New employees wait 72 hours for training. Revenue and Sunday rankings use Lockdown's simulation.</p>
<section id="your-company"><% if(c){ %><article class="economy-card"><span class="eyebrow"><%= type.name %></span><h2><%= c.name %> · <%= c.stars %> ★</h2><p>Director <%= c.director %> · <%= data.staff.length %> / <%= Math.floor(type.size*(1+c.size*.25)) %> employees · <%= c.trains %> trains available</p>
<p>Popularity: <%= c.popularity %>% of the leading company’s weekly revenue</p><div class="economy-metrics"><div><small>VAULT</small><strong><%= cash(c.vault) %></strong></div><div><small>LIFETIME REVENUE</small><strong><%= cash(c.revenue) %></strong></div><div><small>INVENTORY</small><strong><%= c.inventory %> / <%= 1000*(1+c.warehouse) %></strong></div></div>
<% if(director){ %><p>Seven-day reserve: <%= cash(7*(c.advertising+data.staff.reduce((n,e)=>n+e.pay,0))) %></p><form data-economy class="economy-form" action="/companies/action"><input type="hidden" name="action" value="vault"><label>Vault amount<input name="amount" type="number" min="1" step="1" required></label><button class="action-button" name="direction" value="deposit">Deposit</button><button class="action-button" name="direction" value="withdraw">Withdraw</button></form>
<form data-economy class="economy-form" action="/companies/action"><input type="hidden" name="action" value="settings"><label>Product price (RRP <%= cash(type.rrp) %>)<input name="price" type="number" min="1" value="<%= c.price %>" required></label><label>Daily advertising<input name="advertising" type="number" min="0" value="<%= c.advertising %>" required></label><label>Applications<select name="open"><option value="1" <%= c.applications_open?'selected':'' %>>Open</option><option value="0" <%= !c.applications_open?'selected':'' %>>Closed</option></select></label><button class="action-button">Save budget</button></form>
<form data-economy class="economy-form" action="/companies/action"><input type="hidden" name="action" value="order"><label>Order stock · <%= cash(type.wholesale) %> each<input name="quantity" type="number" min="1" step="1" required></label><button class="action-button">Order stock</button></form>
<h3>Upgrades</h3><% for(const kind of ['size','room','warehouse']){ %><form data-economy class="economy-form" action="/companies/action"><input type="hidden" name="action" value="upgrade"><input type="hidden" name="kind" value="<%= kind %>"><span><%= kind==='room'?'Staff room':kind %> · level <%= c[kind] %>/6</span><button class="action-button" <%= c[kind]>=6?'disabled':'' %>>Upgrade · <%= cash(type.cost*(c[kind]+1)*({size:.1,room:.025,warehouse:.05}[kind])) %></button></form><% } %>
<% }else{ %><form data-economy action="/companies/action" data-confirm="Leave this company?"><input type="hidden" name="action" value="leave"><button class="action-button">Leave company</button></form><% } %>
<h3>Employees</h3><% if(!data.staff.length){ %><p>No employees yet. Your company appears in the hiring directory.</p><% } %><% data.staff.forEach(e=>{ %><div class="economy-card"><h3><%= e.username %> · <%= e.effectiveness %>% effectiveness</h3><p><%= data.roles[e.role].name %> · <%= cash(e.pay) %>/day · Joined <%= new Date(e.joined_at*1000).toUTCString() %></p><% if(director){ %><form data-economy class="economy-form" action="/companies/action"><input type="hidden" name="user_id" value="<%= e.user_id %>"><label>Position<select name="role"><% Object.entries(data.roles).forEach(([key,r])=>{ %><option value="<%= key %>" <%= key===e.role?'selected':'' %>><%= r.name %></option><% }); %></select></label><label>Daily pay<input name="pay" type="number" min="0" max="25000000" value="<%= e.pay %>"></label><button class="action-button" name="action" value="employee">Save</button><button class="action-button" name="action" value="train">Train +50 / +25</button><button class="action-button" name="action" value="fire">Dismiss</button></form><form data-economy action="/companies/action" data-confirm="Transfer ownership permanently to this employee?"><input type="hidden" name="action" value="transfer"><input type="hidden" name="user_id" value="<%= e.user_id %>"><button class="action-button">Transfer company</button></form><% } %></div><% }); %>
<h3>Closing reports</h3><div class="economy-table-wrap"><table class="economy-table"><thead><tr><th>UTC closing</th><th>Customers</th><th>Income</th><th>Expenses</th><th>Efficiency</th><th>Environment</th><th>Payroll</th></tr></thead><tbody><% data.reports.forEach(r=>{ %><tr><td><%= new Date((r.day*86400+64800)*1000).toISOString().slice(0,10) %></td><td><%= r.customers %></td><td><%= cash(r.income) %></td><td><%= cash(r.expenses) %></td><td><%= Math.round(r.efficiency) %>%</td><td><%= Math.round(r.environment) %>%</td><td><%= r.funded?'Paid':'Unfunded' %></td></tr><% }); %></tbody></table></div>
<% if(director){ %><form data-economy class="economy-form" action="/companies/action" data-confirm="Sell this company back to the system? This cannot be undone."><input type="hidden" name="action" value="sell"><button class="action-button">Sell company · <%= cash(.75*(type.cost+c.upgrades_spent)+.05*c.revenue+c.vault) %></button></form><% } %></article><% }else{ %><p>You are not part of a company yet. Apply below or start your own.</p><% } %></section>
<h2>Applications</h2><% data.applications.filter(a=>a.status==='pending').forEach(a=>{ %><article class="economy-card"><h3><%= a.username %> → <%= data.companies.find(c=>c.id===a.company_id)?.name %></h3><p><%= a.message %></p><form data-economy class="economy-form" action="/companies/action"><input type="hidden" name="application_id" value="<%= a.id %>"><% if(a.user_id===user.id){ %><button class="action-button" name="action" value="withdraw">Withdraw</button><% }else if(director){ %><input type="hidden" name="action" value="application"><button class="action-button" name="accept" value="yes">Accept</button><button class="action-button" name="accept" value="no">Decline</button><% } %></form></article><% }); %>
<h2>Job points</h2><% if(c){ %><article class="economy-card"><h3>Extra Shift · Lockdown company special</h3><p>At 3 stars, exchange 1 job point for 1 energy. Maximum 100 points per UTC day. Available after the 72-hour recruit period.</p><form data-economy class="economy-form" action="/companies/action"><input type="hidden" name="action" value="special"><label>Job points<input name="points" type="number" min="1" max="100" value="10" required></label><button class="action-button">Use special</button></form></article><% } %><% data.points.forEach(p=>{ %><p><%= data.types.find(t=>t.key===p.type)?.name %>: <strong><%= p.points %></strong> points retained for this company type.</p><% }); %>
<section id="directory"><h2>Hiring directory</h2><div class="economy-grid"><% data.companies.filter(c=>c.applications_open).forEach(c=>{ %><article class="economy-card"><h3><%= c.name %> · <%= c.stars %> ★</h3><p><%= data.types.find(t=>t.key===c.type)?.name %> · Directed by <%= c.director %></p><% if(!data.company){ %><form data-economy class="economy-form" action="/companies/action"><input type="hidden" name="action" value="apply"><input type="hidden" name="company_id" value="<%= c.id %>"><label>Your application<textarea name="message" maxlength="1000" required></textarea></label><button class="action-button">Apply / update</button></form><% } %></article><% }); %></div></section>
<section id="start-company"><h2>Start a company</h2><p>Choose from 39 company types. Startup includes the base company size and a 1,000-unit warehouse.</p><form data-economy class="economy-form" action="/companies/action"><input type="hidden" name="action" value="start"><label>Company name<input name="name" minlength="3" maxlength="60" required></label><label>Company type<select name="type"><% data.types.forEach(t=>{ %><option value="<%= t.key %>"><%= t.name %> · <%= cash(t.cost) %> · <%= t.size %> employees</option><% }); %></select></label><button class="action-button" <%= user.level<10||data.company?'disabled':'' %>>Found company</button></form></section>
<script src="/js/economy.js" defer></script>
