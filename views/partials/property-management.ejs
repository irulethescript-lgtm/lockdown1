<% const cash=n=>'$'+Math.round(n).toLocaleString(); const homeName=key=>HOMES.find(h=>h.key===key)?.name||key; %>
<section id="manage-properties"><h2>Manage your properties</h2>
<div class="economy-metrics"><div><small>MAX HAPPINESS</small><strong><%= user.max_happiness.toLocaleString() %></strong></div><div><small>CURRENT HOME / DAILY FEES</small><strong><%= cash(current.daily) %></strong></div><div><small>UPKEEP OWED</small><strong><%= cash(current.debt) %></strong></div></div>
<p class="economy-notice">Facilities work after moving in. Fire staff and pay upkeep before moving. Fees accrue at midnight UTC; leases expire at 03:30 UTC. Upgrades replace the previous tier at their full price. A pool adds 2% gym gains; a shooting range adds 2% damage.</p>
<% for(const p of properties.concat(current.owner_id!==user.id?[current]:[])){const h=p.home;const owner=p.owner_id;const resident=current.owner_id===owner&&current.home_key===h.key;const isOwner=owner===user.id; %>
<details class="economy-card" <%= resident?'open':'' %>><summary><strong><%= h.name %></strong> · <%= resident?'Current residence':isOwner?'Owned':'Leased' %> · <%= p.happy %> happy</summary>
<p>Daily fees <%= cash(p.daily) %> · Upkeep <%= cash(p.debt) %> · Vault balance <%= cash(p.vault) %></p>
<% if(p.reduction>0){ %><p class="economy-notice">Unpaid upkeep has reduced happiness by <%= Math.round(p.reduction*100) %>%.</p><% } %>
<form data-economy class="economy-form" action="/property/manage"><input type="hidden" name="home_key" value="<%= h.key %>"><input type="hidden" name="owner_id" value="<%= owner %>"><button class="action-button" name="action" value="pay-upkeep">Pay upkeep</button><% if(!resident){ %><button class="action-button" name="action" value="move-in">Move in</button><% } %></form>
<% if(isOwner){ %><h3>Facilities & modifications</h3><div class="economy-grid"><% for(const [key,tiers] of Object.entries(UPGRADES)){const options=tiers.map((u,i)=>({...u,level:i+1})).filter(u=>allowed(h,u)&&u.level>(p.upgrades[key]||0));if(!options.length)continue; %>
<form data-economy class="economy-form" action="/property/manage"><input type="hidden" name="action" value="upgrade"><input type="hidden" name="home_key" value="<%= h.key %>"><input type="hidden" name="upgrade" value="<%= key %>"><label><%= key.replaceAll('_',' ') %><select name="level"><% options.forEach(u=>{ %><option value="<%= u.level %>"><%= u.name %> · <%= cash(key==='interior'?h.price*u.cost:u.cost) %> · +<%= key==='interior'?Math.round(h.happy*u.happy):u.happy %> happy</option><% }); %></select></label><button class="action-button">Upgrade</button></form><% } %></div><% } %>
<% if(resident){ %><h3>Household staff</h3><div class="economy-grid"><% for(const [role,s] of Object.entries(STAFF)){if(h.tier<s.min)continue; %><form data-economy class="economy-form" action="/property/manage"><input type="hidden" name="action" value="staff"><input type="hidden" name="home_key" value="<%= h.key %>"><input type="hidden" name="owner_id" value="<%= owner %>"><input type="hidden" name="role" value="<%= role %>"><label><%= s.name %><select name="count"><option value="0">None / dismiss</option><% s.tiers.forEach(([count,cost,happy])=>{ %><option value="<%= count %>" <%= p.staff[role]===count?'selected':'' %>><%= count %> · <%= cash(cost) %>/day · +<%= happy %> happy</option><% }); %></select></label><button class="action-button">Save staff</button></form><% } %></div>
<% if((isOwner||(partner?.spouse_id===owner&&p.share_vault))&&p.vaultCapacity){ %><h3>Property vault</h3><p><%= cash(p.vault) %> / <%= cash(p.vaultCapacity) %> · Funds stay here when you move.</p><form data-economy class="economy-form" action="/property/manage"><input type="hidden" name="action" value="vault"><input type="hidden" name="owner_id" value="<%= owner %>"><input type="hidden" name="home_key" value="<%= h.key %>"><label>Amount<input name="amount" type="number" min="1" step="1" required></label><button class="action-button" name="direction" value="deposit">Deposit</button><button class="action-button" name="direction" value="withdraw">Withdraw</button></form><% vaultLog.forEach(log=>{ %><p><%= new Date(log.created_at*1000).toISOString() %> · <%= log.amount>0?'Deposit':'Withdrawal' %> <%= cash(Math.abs(log.amount)) %></p><% }); %><% } %><% } %>
<% if(isOwner&&h.price){ %><h3>Sell or lease</h3><p>Vacant properties only. Clear upkeep and remove staff before listing. Empty the vault before selling.</p><form data-economy class="economy-form" action="/property/manage" data-confirm="Sell this vacant property back to the estate agents?"><input type="hidden" name="home_key" value="<%= h.key %>"><button class="action-button" name="action" value="sell-agent">Sell to agents · <%= cash(h.price*.75-p.debt) %></button></form><form data-economy class="economy-form" action="/property/manage"><input type="hidden" name="home_key" value="<%= h.key %>"><label>Market price (0 removes sale)<input name="price" type="number" min="0" step="1" value="<%= p.sale_price %>" required></label><label>Lease days<input name="days" type="number" min="1" max="100" value="7"></label><button class="action-button" name="action" value="list-sale">List for sale</button><button class="action-button" name="action" value="list-lease">Offer lease</button></form><% } %></details><% } %>
<% if(loan){ %><form data-economy class="economy-form" action="/property/manage"><input type="hidden" name="action" value="pay-loan"><p>Expired lease debt: <%= cash(loan) %></p><button class="action-button">Pay loan shark</button></form><% } %>
</section>
<section id="property-market"><h2>Property market</h2><div class="economy-grid"><% sales.forEach(s=>{ %><article class="economy-card"><h3><%= homeName(s.home_key) %></h3><p>Seller: <%= s.seller %> · <%= cash(s.sale_price) %></p><form data-economy action="/property/manage"><input type="hidden" name="action" value="buy-sale"><input type="hidden" name="owner_id" value="<%= s.owner_id %>"><input type="hidden" name="home_key" value="<%= s.home_key %>"><button class="action-button">Buy property</button></form></article><% }); %></div><% if(!sales.length){ %><p>No player properties for sale yet.</p><% } %>
<h3>Rental offers</h3><div class="economy-grid"><% offers.forEach(l=>{ %><article class="economy-card"><h3><%= homeName(l.home_key) %></h3><p><%= l.landlord %> · <%= l.days %> days · <%= cash(l.price) %> upfront</p><p>Upkeep extra. No vault access. Accepted contracts cannot be cancelled.</p><form data-economy action="/property/manage" data-confirm="Pay this lease in full? Accepted contracts cannot be cancelled."><input type="hidden" name="action" value="accept-lease"><input type="hidden" name="lease_id" value="<%= l.id %>"><button class="action-button" <%= l.owner_id===user.id?'disabled':'' %>>Accept lease</button></form><% if(l.owner_id===user.id){ %><form data-economy class="economy-form" action="/property/manage"><input type="hidden" name="action" value="cancel-offer"><input type="hidden" name="lease_id" value="<%= l.id %>"><button class="action-button">Remove offer</button></form><% } %></article><% }); %></div><% if(!offers.length){ %><p>No rental offers yet. List a vacant home to create one.</p><% } %>
<% leases.forEach(l=>{ %><article class="economy-card"><h3>Your lease · <%= homeName(l.home_key) %></h3><p>Ends <%= new Date(l.ends_at*1000).toUTCString() %></p><form data-economy class="economy-form" action="/property/manage"><input type="hidden" name="owner_id" value="<%= l.owner_id %>"><input type="hidden" name="home_key" value="<%= l.home_key %>"><input type="hidden" name="lease_id" value="<%= l.id %>"><button class="action-button" name="action" value="move-in">Move in</button><% if(l.extension_days){ %><button class="action-button" name="action" value="extend-accept">Extend <%= l.extension_days %> days for <%= cash(l.extension_price) %></button><% } %></form></article><% }); %>
<% landlordLeases.forEach(l=>{ %><article class="economy-card"><h3>Offer extension · <%= homeName(l.home_key) %></h3><p>Ends <%= new Date(l.ends_at*1000).toUTCString() %></p><form data-economy class="economy-form" action="/property/manage"><input type="hidden" name="action" value="extend-offer"><input type="hidden" name="lease_id" value="<%= l.id %>"><label>Days<input name="days" type="number" min="1" max="100" value="7"></label><label>Upfront price<input name="price" type="number" min="0" step="1" required></label><button class="action-button">Offer extension</button></form></article><% }); %>
</section>
<section class="economy-card"><h2>Spouse & shared homes</h2>
<% if(partner){ %><p>Spouse: <strong><%= partner.username %></strong>. Your spouse may move into your available homes. Staff management stays with the owner or tenant.</p>
<% sharedHomes.forEach(h=>{ %><form data-economy class="economy-form" action="/property/manage"><input type="hidden" name="action" value="move-in"><input type="hidden" name="home_key" value="<%= h.home_key %>"><input type="hidden" name="owner_id" value="<%= h.owner_id %>"><span><%= homeName(h.home_key) %></span><button class="action-button">Move into spouse's home</button></form><% }); %>
<% properties.filter(p=>p.vaultCapacity).forEach(p=>{ %><form data-economy class="economy-form" action="/property/manage"><input type="hidden" name="action" value="share-vault"><input type="hidden" name="home_key" value="<%= p.home_key %>"><label><%= homeName(p.home_key) %> vault permission<select name="share"><option value="0" <%= !p.share_vault?'selected':'' %>>Private</option><option value="1" <%= p.share_vault?'selected':'' %>>Share with spouse</option></select></label><button class="action-button">Save permission</button></form><% }); %>
<% }else{ %><form data-economy class="economy-form" action="/property/manage"><input type="hidden" name="action" value="partner-invite"><label>Citizen username<input name="username" required maxlength="20"></label><button class="action-button">Invite spouse</button></form><% invitations.forEach(i=>{ %><form data-economy class="economy-form" action="/property/manage" data-confirm="Accept this spouse invitation?"><input type="hidden" name="action" value="partner-accept"><input type="hidden" name="sender_id" value="<%= i.sender_id %>"><span><%= i.username %> invited you to be their spouse.</span><button class="action-button">Accept</button></form><% }); %><% } %></section>
